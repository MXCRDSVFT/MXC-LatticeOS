RUNTIME_RECEIPT_NETWORK=lattice
RUNTIME_RECEIPT_PREFIX=LATTICE
# Lattice receives VORTEX as a telemetry source, alongside Thunder and Starburst.
LATTICE_RECEIPT_CIN_ENDPOINT=http://<cin-receiver>
LATTICE_RECEIPT_EVE_ENDPOINT=http://<eve-receiver>
LATTICE_RECEIPT_ORACLE_ENDPOINT=http://<oracle-receiver>
LATTICE_RECEIPT_TOKEN=<lattice-secret>
LATTICE_RECEIPT_TIMEOUT=5
RUNTIME_RECEIPT_HOST=0.0.0.0
RUNTIME_RECEIPT_PORT=6982
# Explicit combined scope example: RUNTIME_RECEIPT_NETWORK=coremesh+lattice
